# Frontend environment variables
# Only EXPO_PUBLIC_* vars are bundled into the app at build time.
# The backend URL is selected by `EXPO_PUBLIC_RELEASE_CHANNEL` (development|staging|production)
# and the actual URLs are defined in src/constants/env.ts.
#
# Override the channel here if you want to point a local Expo Go session
# at staging or production:
#   EXPO_PUBLIC_RELEASE_CHANNEL=staging
#
# The frontend NEVER connects to the database directly — DATABASE_URL belongs
# on the backend only.
